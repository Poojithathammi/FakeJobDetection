{
  "manifest_version": 3,
  "name": "Fake Job Detector",
  "version": "1.0",
  "description": "Detect potentially fake job postings using machine learning.",

  "permissions": [
    "activeTab"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}